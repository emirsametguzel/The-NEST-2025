# =============================================================================
# .gitignore — Güvenlik ve Gizlilik Yapılandırması
# =============================================================================

# Ortam değişkenleri ve gizli anahtarlar (ASLA commit edilmemeli)
.env
.env.*
.env.local
.env.development
.env.production
.env.test
server/.env
server/.env.*
server/.env.local
server/.env.production

# Sertifikalar ve Özel Anahtarlar
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# Firebase ve Hizmet Hesabı (Service Account) Dosyaları
firebase-service-account.json
*serviceAccount*.json
*service-account*.json
*credentials*.json
firebase-applet-config.json
firebase_applet_config.xml

# Veritabanı Dosyaları ve SQLite Kilitleri
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/*.sqlite*
!data/.gitkeep

# Kullanıcı Yüklemeleri (Avatarlar, Medya)
uploads/avatars/*
!uploads/avatars/.gitkeep

# Node.js Bağımlılıkları ve Loglar
node_modules/
server/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lock
*.log

# Editör & İşletim Sistemi Kalıntıları
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
