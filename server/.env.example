# =============================================================================
# The Nest — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin.
# .env dosyası ASLA git'e commit edilmemelidir (.gitignore'a ekli).
# =============================================================================

# Uygulama ortamı: "development" veya "production"
# production'da cookie'lerin Secure bayrağı otomatik aktif olur (yalnızca HTTPS).
NODE_ENV=development

PORT=3000

# Session imzalama anahtarı — en az 32 karakter, rastgele üretin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ASLA örnekteki gibi tahmin edilebilir bir değer kullanmayın.
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING

# Kayıt formunu geçici olarak kapatmak için "false" yapın (ör. ilk üyelik
# döneminden sonra). PHP config.php'deki registration_enabled ile aynı amaç.
REGISTRATION_ENABLED=true

# Veritabanı dosya yolu (varsayılan: ../data/the-nest.sqlite)
# DB_PATH=/mutlak/yol/the-nest.sqlite

# --- Şifre Sıfırlama E-postası (Nodemailer / SMTP) ---
# Tanımlı değilse (SMTP_HOST boşsa), OTP kodu gerçekten gönderilmez;
# yalnızca geliştirme kolaylığı için sunucu terminaline yazdırılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Nest <noreply@the-nest.com.tr>
